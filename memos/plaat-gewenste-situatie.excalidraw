    },
    {
      "id": "97gvVzir0mIt_IrqSc9-8",
      "type": "text",
      "x": 45,
      "y": 365,
      "width": 250,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
