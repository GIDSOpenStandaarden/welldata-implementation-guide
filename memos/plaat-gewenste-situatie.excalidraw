      "text": "Burger\nlogt in met DigiD of\nGIDS private ID",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Bg_oLa342LpiV62ibPZQr",
      "originalText": "Burger\nlogt in met DigiD of\nGIDS private ID",
      "autoResize": true,
