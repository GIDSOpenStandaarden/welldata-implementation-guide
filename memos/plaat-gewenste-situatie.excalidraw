      "isDeleted": false,
      "boundElements": [],
      "updated": 1793051056200,
      "link": null,
      "locked": false,
      "text": "c) Backend\nopenEHR + pod*",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
